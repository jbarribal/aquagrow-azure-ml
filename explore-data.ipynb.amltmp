      "cell_type": "code",
      "source": [
        "df['weight'] = new_weights_df\r\n",
        "print(df.head())\r\n",
        "# write file to filesystem\r\n",
        "df.to_parquet(\"./data/clean-mean-dataset.parquet\")"
      ],
      "outputs": [
        {
